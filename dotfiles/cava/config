# Cava — Audio Visualizer

[general]
framerate = 60
bars = 32
bar_width = 3
bar_spacing = 1
sensitivity = 100

[input]
method = pipewire
source = auto

[output]
method = ncurses

[color]
gradient = 1
gradient_count = 4
gradient_color_1 = '#89b4fa'
gradient_color_2 = '#cba6f7'
gradient_color_3 = '#f5c2e7'
gradient_color_4 = '#f38ba8'

[smoothing]
monstercat = 1
waves = 1
