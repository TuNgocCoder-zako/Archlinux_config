#!/bin/bash
# ╔══════════════════════════════════════════════════╗
# ║  Set Wallpaper & Persist across Reboots          ║
# ╚══════════════════════════════════════════════════╝

IMG="$1"
if [ -z "$IMG" ] || [ ! -f "$IMG" ]; then
    notify-send "Error" "No valid image file provided"
    exit 1
fi

# Get absolute path
IMG_PATH="$(realpath "$IMG")"

# Ensure directories exist
mkdir -p ~/.cache ~/.local/state/caelestia/wallpaper

# Save persistent path
echo "$IMG_PATH" > ~/.cache/current_wallpaper
echo "$IMG_PATH" > ~/.local/state/caelestia/wallpaper/path.txt

# Apply to Caelestia Shell
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

caelestia wallpaper -f "$IMG_PATH"
notify-send -i "$IMG_PATH" "Caelestia" "Wallpaper set & saved for next boots!"
