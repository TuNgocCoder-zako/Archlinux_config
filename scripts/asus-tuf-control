#!/usr/bin/env python3
import sys
import os
import glob
import subprocess
import gi

gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Gtk, Adw, GLib

def get_cpu_temp():
    for path in glob.glob("/sys/class/hwmon/hwmon*"):
        try:
            with open(os.path.join(path, "name")) as f:
                if f.read().strip() == "coretemp":
                    with open(os.path.join(path, "temp1_input")) as tf:
                        return int(tf.read().strip()) / 1000.0
        except:
            pass
    try:
        with open("/sys/class/thermal/thermal_zone0/temp") as f:
            return int(f.read().strip()) / 1000.0
    except:
        return 0.0

def get_gpu_temp():
    try:
        status_path = "/sys/bus/pci/devices/0000:01:00.0/power/runtime_status"
        if os.path.exists(status_path):
            with open(status_path, "r") as f:
                if f.read().strip() == "suspended":
                    return None
        ac_path = "/sys/class/power_supply/ACAD/online"
        if os.path.exists(ac_path):
            with open(ac_path, "r") as f:
                if f.read().strip() == "0":
                    return None
        res = subprocess.run(["nvidia-smi", "--query-gpu=temperature.gpu", "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=1)
        return float(res.stdout.strip())
    except:
        return None

def get_fan_speeds():
    cpu_fan, gpu_fan = 0, 0
    for path in glob.glob("/sys/class/hwmon/hwmon*"):
        try:
            with open(os.path.join(path, "name")) as f:
                if f.read().strip() == "asus":
                    with open(os.path.join(path, "fan1_input")) as f1:
                        cpu_fan = int(f1.read().strip())
                    with open(os.path.join(path, "fan2_input")) as f2:
                        gpu_fan = int(f2.read().strip())
                    break
        except:
            pass
    return cpu_fan, gpu_fan

def get_active_profile():
    try:
        res = subprocess.run(["asusctl", "profile", "get"], capture_output=True, text=True, timeout=2)
        for line in res.stdout.splitlines():
            if "Active profile:" in line:
                return line.split(":")[-1].strip()
    except:
        pass
    return "Balanced"

def set_active_profile(profile):
    subprocess.run(["asusctl", "profile", "set", profile], capture_output=True)

def is_auto_service_active():
    res = subprocess.run(["systemctl", "--user", "is-active", "asus-fan-auto.service"], capture_output=True, text=True)
    return res.stdout.strip() == "active"

def set_auto_service(active):
    cmd = "start" if active else "stop"
    subprocess.run(["systemctl", "--user", cmd, "asus-fan-auto.service"], capture_output=True)
    enable_cmd = "enable" if active else "disable"
    subprocess.run(["systemctl", "--user", enable_cmd, "asus-fan-auto.service"], capture_output=True)

class AsusTufApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id='com.asus.tuf.control')
        self.updating_ui = False

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = AsusTufWindow(application=self)
        win.present()

class AsusTufWindow(Adw.ApplicationWindow):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.set_title("ASUS TUF Fan & System Control")
        self.set_default_size(520, 680)

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.set_content(main_box)

        # Header Bar
        header = Adw.HeaderBar()
        main_box.append(header)

        # Content Page
        clamp = Adw.Clamp()
        clamp.set_maximum_size(500)
        main_box.append(clamp)

        scroll = Gtk.ScrolledWindow()
        scroll.set_vexpand(True)
        clamp.set_child(scroll)

        pref_page = Adw.PreferencesPage()
        scroll.set_child(pref_page)

        # Group 1: Monitoring
        mon_group = Adw.PreferencesGroup(title="Thông số phần cứng (Thời gian thực)")
        pref_page.add(mon_group)

        self.row_temp = Adw.ActionRow(title="Nhiệt độ CPU")
        self.lbl_temp = Gtk.Label(label="-- °C")
        self.lbl_temp.add_css_class("title-3")
        self.row_temp.add_suffix(self.lbl_temp)
        mon_group.add(self.row_temp)

        self.row_gpu_temp = Adw.ActionRow(title="Nhiệt độ GPU (NVIDIA)")
        self.lbl_gpu_temp = Gtk.Label(label="-- °C")
        self.lbl_gpu_temp.add_css_class("title-3")
        self.row_gpu_temp.add_suffix(self.lbl_gpu_temp)
        mon_group.add(self.row_gpu_temp)

        self.row_cpu_fan = Adw.ActionRow(title="Tốc độ quạt CPU")
        self.lbl_cpu_fan = Gtk.Label(label="-- RPM")
        self.lbl_cpu_fan.add_css_class("title-3")
        self.row_cpu_fan.add_suffix(self.lbl_cpu_fan)
        mon_group.add(self.row_cpu_fan)

        self.row_gpu_fan = Adw.ActionRow(title="Tốc độ quạt GPU")
        self.lbl_gpu_fan = Gtk.Label(label="-- RPM")
        self.lbl_gpu_fan.add_css_class("title-3")
        self.row_gpu_fan.add_suffix(self.lbl_gpu_fan)
        mon_group.add(self.row_gpu_fan)

        # Group 2: Mode Profiles
        profile_group = Adw.PreferencesGroup(title="Chế độ quạt / Hiệu năng")
        pref_page.add(profile_group)

        prof_row = Adw.ActionRow(title="Chọn chế độ quạt")
        prof_row.set_subtitle("Điều khiển mức làm mát và xung nhịp máy")
        
        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        btn_box.set_valign(Gtk.Align.CENTER)

        self.btn_quiet = Gtk.Button(label="🤫 Quiet")
        self.btn_balanced = Gtk.Button(label="⚖️ Balanced")
        self.btn_perf = Gtk.Button(label="🚀 Turbo")

        self.btn_quiet.connect("clicked", lambda b: self.on_change_profile("Quiet"))
        self.btn_balanced.connect("clicked", lambda b: self.on_change_profile("Balanced"))
        self.btn_perf.connect("clicked", lambda b: self.on_change_profile("Performance"))

        btn_box.append(self.btn_quiet)
        btn_box.append(self.btn_balanced)
        btn_box.append(self.btn_perf)
        prof_row.add_suffix(btn_box)
        profile_group.add(prof_row)

        # Group 3: Auto Thermal Switch
        auto_group = Adw.PreferencesGroup(title="Tự động hóa thông minh")
        pref_page.add(auto_group)

        self.switch_auto = Gtk.Switch()
        self.switch_auto.set_valign(Gtk.Align.CENTER)
        self.switch_auto.set_active(is_auto_service_active())
        self.switch_auto.connect("state-set", self.on_auto_switch_toggled)

        row_auto = Adw.ActionRow(title="Tự động chuyển chế độ theo nhiệt độ")
        row_auto.set_subtitle("Bung xõa quạt Turbo/Performance (> 50°C) và giảm về Balanced khi CPU ≤ 50°C")
        row_auto.add_suffix(self.switch_auto)
        auto_group.add(row_auto)

        # Group 4: Battery Care
        bat_group = Adw.PreferencesGroup(title="Bảo vệ pin (Battery Care)")
        pref_page.add(bat_group)

        row_bat = Adw.ActionRow(title="Giới hạn sạc pin")
        self.row_bat = row_bat
        
        bat_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        bat_box.set_valign(Gtk.Align.CENTER)
        
        self.btn_bat_60 = Gtk.Button(label="60%")
        self.btn_bat_80 = Gtk.Button(label="80%")
        self.btn_bat_100 = Gtk.Button(label="100%")
        
        self.btn_bat_60.connect("clicked", lambda b: self.set_bat_limit(60))
        self.btn_bat_80.connect("clicked", lambda b: self.set_bat_limit(80))
        self.btn_bat_100.connect("clicked", lambda b: self.set_bat_limit(100))
        
        bat_box.append(self.btn_bat_60)
        bat_box.append(self.btn_bat_80)
        bat_box.append(self.btn_bat_100)
        row_bat.add_suffix(bat_box)
        bat_group.add(row_bat)

        # Group 5: Keyboard Brightness
        led_group = Adw.PreferencesGroup(title="Đèn nền bàn phím")
        pref_page.add(led_group)

        row_led = Adw.ActionRow(title="Độ sáng LED")
        led_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        led_box.set_valign(Gtk.Align.CENTER)

        btn_led_off = Gtk.Button(label="Tắt")
        btn_led_low = Gtk.Button(label="Thấp")
        btn_led_med = Gtk.Button(label="Vừa")
        btn_led_high = Gtk.Button(label="Sáng")

        btn_led_off.connect("clicked", lambda b: subprocess.run(["asusctl", "leds", "set", "off"], capture_output=True))
        btn_led_low.connect("clicked", lambda b: subprocess.run(["asusctl", "leds", "set", "low"], capture_output=True))
        btn_led_med.connect("clicked", lambda b: subprocess.run(["asusctl", "leds", "set", "med"], capture_output=True))
        btn_led_high.connect("clicked", lambda b: subprocess.run(["asusctl", "leds", "set", "high"], capture_output=True))

        led_box.append(btn_led_off)
        led_box.append(btn_led_low)
        led_box.append(btn_led_med)
        led_box.append(btn_led_high)
        row_led.add_suffix(led_box)
        led_group.add(row_led)

        row_aura = Adw.ActionRow(title="Hiệu ứng màu Aura RGB")
        row_aura.set_subtitle("Đổi kiểu chuyển động và màu sắc bàn phím")
        aura_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        aura_box.set_valign(Gtk.Align.CENTER)

        btn_aura_rainbow = Gtk.Button(label="🌈 Rainbow")
        btn_aura_cyan = Gtk.Button(label="💎 Cyan")
        btn_aura_purple = Gtk.Button(label="💜 Tím")
        btn_aura_white = Gtk.Button(label="⚪ Trắng")
        btn_aura_breathe = Gtk.Button(label="🌊 Thở")

        btn_aura_rainbow.connect("clicked", lambda b: subprocess.run(["asusctl", "aura", "effect", "rainbow-cycle", "--speed", "med"], capture_output=True))
        btn_aura_cyan.connect("clicked", lambda b: subprocess.run(["asusctl", "aura", "effect", "static", "-c", "00e5ff"], capture_output=True))
        btn_aura_purple.connect("clicked", lambda b: subprocess.run(["asusctl", "aura", "effect", "static", "-c", "cba6f7"], capture_output=True))
        btn_aura_white.connect("clicked", lambda b: subprocess.run(["asusctl", "aura", "effect", "static", "-c", "ffffff"], capture_output=True))
        btn_aura_breathe.connect("clicked", lambda b: subprocess.run(["asusctl", "aura", "effect", "breathe", "--speed", "med", "-c", "00e5ff", "-c", "ff007f"], capture_output=True))

        aura_box.append(btn_aura_rainbow)
        aura_box.append(btn_aura_cyan)
        aura_box.append(btn_aura_purple)
        aura_box.append(btn_aura_white)
        aura_box.append(btn_aura_breathe)
        row_aura.add_suffix(aura_box)
        led_group.add(row_aura)

        # Group 6: Touchpad Control
        tp_group = Adw.PreferencesGroup(title="Bàn di chuột (Touchpad)")
        pref_page.add(tp_group)

        row_tp = Adw.ActionRow(title="Khóa / Mở bàn di chuột")
        row_tp.set_subtitle("Bật hoặc tắt Touchpad chống chạm nhầm (Phím tắt: Super + F10)")
        self.switch_tp = Gtk.Switch()
        self.switch_tp.set_valign(Gtk.Align.CENTER)
        self.switch_tp.set_active(not os.path.exists("/tmp/touchpad-disabled"))
        self.switch_tp.connect("state-set", self.on_tp_switch_toggled)
        row_tp.add_suffix(self.switch_tp)
        tp_group.add(row_tp)

        # Initial Refresh & Timer
        self.refresh_stats()
        GLib.timeout_add_seconds(2, self.refresh_stats)

    def on_change_profile(self, prof):
        set_active_profile(prof)
        self.refresh_profile_buttons(prof)

    def set_bat_limit(self, limit):
        subprocess.run(["asusctl", "battery", "limit", str(limit)], capture_output=True)
        self.refresh_bat_buttons(limit)
        subprocess.run(["notify-send", "-a", "ASUS Battery", f"Đã đặt giới hạn sạc pin ở {limit}%"])

    def refresh_bat_buttons(self, limit=None):
        if limit is None:
            try:
                with open("/sys/class/power_supply/BAT1/charge_control_end_threshold") as f:
                    limit = int(f.read().strip())
            except Exception:
                limit = 80
        for b in (self.btn_bat_60, self.btn_bat_80, self.btn_bat_100):
            b.remove_css_class("suggested-action")
        if limit <= 60:
            self.btn_bat_60.add_css_class("suggested-action")
        elif limit <= 80:
            self.btn_bat_80.add_css_class("suggested-action")
        else:
            self.btn_bat_100.add_css_class("suggested-action")
        self.row_bat.set_subtitle(f"Đang giới hạn sạc ở: {limit}% (Ngắt sạc khi pin đạt {limit}%)")

    def on_auto_switch_toggled(self, switch, state):
        set_auto_service(state)
        status_text = "đã BẬT" if state else "đã TẮT"
        subprocess.run(["notify-send", "-a", "ASUS Auto Fan", f"Chế độ tự động {status_text}"])
        return False

    def on_tp_switch_toggled(self, switch, state):
        cmd = "on" if state else "off"
        subprocess.run(["/home/tu/.local/bin/touchpad-toggle", cmd], capture_output=True)
        return False

    def refresh_profile_buttons(self, active_prof):
        for btn in (self.btn_quiet, self.btn_balanced, self.btn_perf):
            btn.remove_css_class("suggested-action")
            btn.remove_css_class("destructive-action")

        if active_prof == "Quiet":
            self.btn_quiet.add_css_class("suggested-action")
        elif active_prof == "Balanced":
            self.btn_balanced.add_css_class("suggested-action")
        elif active_prof == "Performance":
            self.btn_perf.add_css_class("destructive-action")

    def refresh_stats(self):
        temp = get_cpu_temp()
        gpu_temp = get_gpu_temp()
        cpu_rpm, gpu_rpm = get_fan_speeds()
        prof = get_active_profile()

        self.lbl_temp.set_text(f"{temp:.1f} °C")
        if gpu_temp is None:
            self.lbl_gpu_temp.set_text("D3cold (0W)")
        else:
            self.lbl_gpu_temp.set_text(f"{gpu_temp:.0f} °C")
        self.lbl_cpu_fan.set_text(f"{cpu_rpm} RPM")
        self.lbl_gpu_fan.set_text(f"{gpu_rpm} RPM")
        self.refresh_profile_buttons(prof)
        self.refresh_bat_buttons()
        tp_active = not os.path.exists("/tmp/touchpad-disabled")
        if self.switch_tp.get_active() != tp_active:
            self.switch_tp.set_state(tp_active)
        return True

if __name__ == "__main__":
    app = AsusTufApp()
    app.run(sys.argv)
