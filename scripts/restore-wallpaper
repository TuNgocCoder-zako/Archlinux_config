#!/bin/bash
# Restore Last Wallpaper on Boot

CACHE_FILE="${HOME}/.cache/current_wallpaper"
DEFAULT_WALL="${HOME}/Pictures/Wallpapers/emilia_dark.png"

# Wait for Caelestia Shell (max 15s)
TIMEOUT=30
while ! pgrep -x caelestia > /dev/null 2>&1; do
    sleep 0.5
    TIMEOUT=$((TIMEOUT - 1))
    [ "$TIMEOUT" -le 0 ] && exit 1
done

if [ -f "$CACHE_FILE" ] && [ -s "$CACHE_FILE" ]; then
    SAVED_WALL="$(cat "$CACHE_FILE")"
    [ -f "$SAVED_WALL" ] && { caelestia wallpaper -f "$SAVED_WALL"; exit 0; }
fi

[ -f "$DEFAULT_WALL" ] && caelestia wallpaper -f "$DEFAULT_WALL"
