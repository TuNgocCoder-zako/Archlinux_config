#!/bin/bash
# Restore Last Wallpaper on Boot

CACHE_FILE="${HOME}/.cache/current_wallpaper"
DEFAULT_WALL="${HOME}/Pictures/Wallpapers/emilia_dark.png"

# Wait for Caelestia Shell (Quickshell)
TIMEOUT=30
while ! pgrep -f "qs.*caelestia" > /dev/null 2>&1 && ! pgrep -x qs > /dev/null 2>&1; do
    sleep 0.5
    TIMEOUT=$((TIMEOUT - 1))
    [ "$TIMEOUT" -le 0 ] && break
done

if [ -f "$CACHE_FILE" ] && [ -s "$CACHE_FILE" ]; then
    SAVED_WALL="$(cat "$CACHE_FILE")"
    if [ -f "$SAVED_WALL" ]; then
        ~/.local/bin/set-wallpaper "$SAVED_WALL"
        exit 0
    fi
fi

if [ -f "$DEFAULT_WALL" ]; then
    ~/.local/bin/set-wallpaper "$DEFAULT_WALL"
fi
