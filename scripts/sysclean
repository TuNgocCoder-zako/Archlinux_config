#!/usr/bin/env python3
"""
sysclean 2.0 - Trình dọn dẹp hệ thống & tệp dư thừa toàn diện cho Arch Linux / CachyOS.
Hỗ trợ quét 3 cấp độ:
  - [An toàn]: Thùng rác, Web cache, Thumbnail, GPU Shader cache, file log tạm.
  - [Tùy chọn]: Spotify cache, HuggingFace AI models, Playwright, JetBrains IDE, NPM/Pip/Cargo.
  - [Hệ thống]: Pacman cache (paccache), Gói mồ côi (orphans), Systemd Journal, Coredump, Docker.

TUYỆT ĐỐI KHÔNG xóa mã nguồn dự án, dữ liệu cá nhân hay file cấu hình quan trọng.
"""

import os
import sys
import shutil
import glob
import subprocess
import argparse
import time

# Mã màu ANSI
RESET   = "\033[0m"
BOLD    = "\033[1m"
DIM     = "\033[2m"
GREEN   = "\033[32m"
YELLOW  = "\033[33m"
CYAN    = "\033[36m"
RED     = "\033[31m"
MAGENTA = "\033[35m"
BLUE    = "\033[34m"

VERSION = "2.0.0"

def format_size(bytes_size):
    """Định dạng byte sang B, KB, MB, GB dễ đọc."""
    if bytes_size <= 0:
        return "0 B"
    for unit in ["B", "KB", "MB", "GB", "TB"]:
        if bytes_size < 1024.0:
            return f"{bytes_size:.1f} {unit}"
        bytes_size /= 1024.0
    return f"{bytes_size:.1f} PB"

def get_disk_info(path="/"):
    """Lấy thông tin dung lượng ổ đĩa gốc."""
    try:
        total, used, free = shutil.disk_usage(path)
        return total, used, free
    except Exception:
        return 0, 0, 0

def get_path_size(path):
    """Tính dung lượng thực tế của một file hoặc thư mục."""
    if not os.path.exists(path):
        return 0
    if os.path.islink(path):
        return 0
    if os.path.isfile(path):
        try:
            return os.path.getsize(path)
        except OSError:
            return 0
    total = 0
    try:
        with os.scandir(path) as it:
            for entry in it:
                try:
                    if entry.is_symlink():
                        continue
                    if entry.is_file():
                        total += entry.stat().st_size
                    elif entry.is_dir():
                        total += get_path_size(entry.path)
                except OSError:
                    continue
    except OSError:
        pass
    return total

def clear_directory_contents(dir_path, dry_run=False):
    """Xóa nội dung bên trong một thư mục (giữ lại thư mục gốc)."""
    if not os.path.exists(dir_path):
        return 0
    freed = 0
    try:
        with os.scandir(dir_path) as it:
            for entry in list(it):
                try:
                    size = get_path_size(entry.path)
                    if not dry_run:
                        if entry.is_dir() and not entry.is_symlink():
                            shutil.rmtree(entry.path, ignore_errors=True)
                        else:
                            os.remove(entry.path)
                    freed += size
                except Exception:
                    pass
    except Exception:
        pass
    return freed

class TargetCategory:
    def __init__(self, key, name, description, paths, tier="safe"):
        self.key = key
        self.name = name
        self.description = description
        self.paths = paths
        self.tier = tier  # "safe", "optional", "system"

    def calculate_size(self):
        total = 0
        for p in self.paths:
            expanded = os.path.expanduser(p)
            for match in glob.glob(expanded):
                total += get_path_size(match)
        return total

    def clean(self, dry_run=False):
        freed = 0
        for p in self.paths:
            expanded = os.path.expanduser(p)
            for match in glob.glob(expanded):
                if os.path.isfile(match):
                    try:
                        s = os.path.getsize(match)
                        if not dry_run:
                            os.remove(match)
                        freed += s
                    except Exception:
                        pass
                elif os.path.isdir(match):
                    freed += clear_directory_contents(match, dry_run=dry_run)
        return freed

