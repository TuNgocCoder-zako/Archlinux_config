# ──────────────────────────────────────────────────────────────
# Typing & Cursor Effects (Kitty trail & VS Code smooth caret)
# ──────────────────────────────────────────────────────────────
def configure_typing_effects(ac_online: bool):
    """
    Tự động tắt hiệu ứng gõ phím khi dùng pin để chống lag và tiết kiệm điện:
    - Kitty terminal: cursor_trail (0 khi dùng pin, 1 khi cắm sạc)
    - VS Code: editor.cursorSmoothCaretAnimation (off khi dùng pin, on khi cắm sạc)
    """
    # 1. Kitty terminal cursor trail
    kitty_conf = os.path.expanduser("~/Archlinux_config/dotfiles/kitty/kitty.conf")
    if os.path.exists(kitty_conf):
        try:
            with open(kitty_conf, "r", encoding="utf-8") as f:
                content = f.read()
            target_val = "1" if ac_online else "0"
            new_content = re.sub(r"cursor_trail\s+[01]", f"cursor_trail                 {target_val}", content)
            if new_content != content:
                with open(kitty_conf, "w", encoding="utf-8") as f:
                    f.write(new_content)
                subprocess.run(["pkill", "-USR1", "-x", "kitty"], capture_output=True)
                print(f"[AutoPower] Kitty cursor_trail → {target_val} ({'ON' if ac_online else 'OFF - không lag phím'})", flush=True)
        except Exception as e:
            print(f"[AutoPower] Kitty config error: {e}", file=sys.stderr, flush=True)

    # 2. VS Code smooth caret animation
    vscode_settings = os.path.expanduser("~/.config/Code/User/settings.json")
    if os.path.exists(vscode_settings):
        try:
            with open(vscode_settings, "r", encoding="utf-8") as f:
                content = f.read()
            target_val = "on" if ac_online else "off"
            new_content = re.sub(r'"editor\.cursorSmoothCaretAnimation":\s*"(on|off)"', f'"editor.cursorSmoothCaretAnimation": "{target_val}"', content)
            if new_content != content:
                with open(vscode_settings, "w", encoding="utf-8") as f:
                    f.write(new_content)
                print(f"[AutoPower] VS Code smooth caret → {target_val}", flush=True)
        except Exception as e:
            print(f"[AutoPower] VS Code config error: {e}", file=sys.stderr, flush=True)

