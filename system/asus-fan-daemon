# Stale SingletonLock cleaner
# ──────────────────────────────────────────────────────────────
def clean_stale_singleton_locks():
    home = os.path.expanduser("~")
    target_dirs = [
        os.path.join(home, ".config", "BraveSoftware", "Brave-Browser"),
        os.path.join(home, ".config", "google-chrome"),
        os.path.join(home, ".config", "chromium"),
        os.path.join(home, ".config", "ZaloData"),
        os.path.join(home, ".config", "discord"),
        os.path.join(home, ".config", "Code"),
    ]
    for d in target_dirs:
        lock_file = os.path.join(d, "SingletonLock")
        if os.path.islink(lock_file) or os.path.exists(lock_file):
            try:
                target = os.readlink(lock_file)
                parts  = target.split("-")
                pid    = int(parts[-1])
                try:
                    os.kill(pid, 0)
                except OSError:
                    print(f"[AutoPower] Cleaning stale lock in {d} (PID {pid} dead)", flush=True)
                    for item in ["SingletonLock", "SingletonCookie", "SingletonSocket"]:
                        p = os.path.join(d, item)
                        if os.path.islink(p) or os.path.exists(p):
                            try:
                                os.unlink(p)
                            except Exception:
                                pass
            except Exception:
                pass

def clean_quickshell_ramdisk():
    """Prevent runaway quickshell/Qt logs from exhausting /run/user/1000 tmpfs."""
    try:
        run_user = "/run/user/1000"
        if not os.path.exists(run_user):
            return

        # 1. Truncate any quickshell log file exceeding 10 MB
        for pattern in ["/run/user/1000/quickshell/by-id/*/*.log", "/run/user/1000/quickshell/by-id/*/*.qslog"]:
            for log_file in glob.glob(pattern):
                try:
                    if os.path.isfile(log_file) and os.path.getsize(log_file) > 10 * 1024 * 1024:
                        os.truncate(log_file, 0)
                        print(f"[AutoPower] Truncated oversized quickshell log: {log_file}", flush=True)
                except Exception:
                    pass

        # 2. Emergency check: if /run/user/1000 exceeds 80% capacity, truncate all logs
        st = os.statvfs(run_user)
        if st.f_blocks > 0:
            used_pct = (1.0 - st.f_bavail / st.f_blocks) * 100
            if used_pct > 80.0:
                print(f"[AutoPower] ⚠️ /run/user/1000 critical ({used_pct:.1f}% used). Truncating quickshell logs...", flush=True)
                for pattern in ["/run/user/1000/quickshell/by-id/*/*.log", "/run/user/1000/quickshell/by-id/*/*.qslog"]:
                    for log_file in glob.glob(pattern):
                        try:
                            if os.path.isfile(log_file):
                                os.truncate(log_file, 0)
                        except Exception:
                            pass
    except Exception:
        pass


# ──────────────────────────────────────────────────────────────
# Main power state handler
# ──────────────────────────────────────────────────────────────
def on_power_state_change(ac_online):
    clean_stale_singleton_locks()
    clean_quickshell_ramdisk()
    manage_background_tasks(ac_online)
    configure_typing_effects(ac_online)

    if not ac_online:
        # ════════════════════════════════
        # BATTERY MODE — MƯỢT MÀ & TẮT HIỆU ỨNG GÕ PHÍM TIẾT KIỆM PIN
        # ════════════════════════════════
        print("[AutoPower] AC disconnected → BATTERY MODE (60Hz, Typing Effects: OFF, Balanced)", flush=True)

        # 0. Ngắt kết nối NVML để dGPU NVIDIA RTX 3050 có thể ngủ sâu D3cold (tiết kiệm ~7W)
        shutdown_nvml()

        # 1. Chuyển màn hình về 60Hz để giảm 58% tải đồ họa và triệt tiêu sụt áp pin
        set_refresh_rate(60)

        # 2. Hyprland: Tắt Shadow, tắt Blur, tắt Animations để giải phóng 100% shader GPU và render load
        configure_hyprland_effects(False)

        # 3. Caelestia: Chế độ siêu nhẹ (tắt hover dashboard/taskbar, tắt visualiser/lyrics, giữ Utilities & Launcher)
        configure_caelestia(False)

        # 4. CPU profile: power-saver (intel_pstate tiết kiệm tối đa, EPP: power, CPU idle ~800MHz)
        try:
            subprocess.run(["powerprofilesctl", "set", "power-saver"], capture_output=True, timeout=3)
            print("[AutoPower] CPU → power-saver (EPP: power, tối đa thời lượng pin)", flush=True)
        except Exception:
            pass

        # 5. ASUS profile: Quiet (Quạt 0 RPM im lặng tuyệt đối, ngắt điện mô-tơ quạt, tiết kiệm ~2W-3W)
        set_asus_profile("Quiet")

        # 6. Tắt đèn bàn phím RGB khi dùng pin để tiết kiệm điện
        set_keyboard_backlight("off")

        # 7. Đảm bảo cổng PCIe của NVIDIA (dGPU + Audio Controller) ở chế độ auto (D3cold - 0W)
        for dev in ["0000:01:00.0", "0000:01:00.1"]:
            try:
                with open(f"/sys/bus/pci/devices/{dev}/power/control", "w") as f:
                    f.write("auto\n")
            except Exception:
                pass

        # 8. Bluetooth: KHÔNG TẮT (Tránh reset co-existence chip Wi-Fi combo MT7921)
        # Module Bluetooth ở trạng thái chờ chỉ tiêu thụ ~0.05W, giữ bật để mạng Wi-Fi không rớt

        # 9. Độ sáng màn hình 40% (tiết kiệm ~3W so với 70%)
        set_brightness_percent(BATTERY_BRIGHTNESS_PERCENT)

        # 10. Thông báo người dùng
        subprocess.run([
            "notify-send", "-u", "normal", "-i", "battery-good",
            "🔋 Chế độ Pin — Tiết Kiệm Tối Đa",
            "60Hz • Tắt Taskbar & Hình nền • Tắt Cava/Shimeji • Quạt 0 RPM • dGPU 0W"
        ], capture_output=True)

    else:
        # ════════════════════════════════
        # AC MODE — Tối đa Hiệu năng & 144Hz
        # ════════════════════════════════
        print("[AutoPower] AC connected → PERFORMANCE MODE (144Hz, max boost)", flush=True)

        # 1. Khôi phục 144Hz
        set_refresh_rate(144)

        # 2. Hyprland: Khôi phục hiệu ứng đầy đủ (Shadow ON, Blur passes = 2, Animations ON)
        configure_hyprland_effects(True)

        # 3. Caelestia: Khôi phục giao diện đầy đủ (Dashboard, Taskbar hover, Visualiser, Sidebar)
        configure_caelestia(True)

        # 4. Performance CPU profile on AC (Tối đa độ nhạy, Intel Turbo boost tức thì, 0 micro-stutter)
        try:
            subprocess.run(["powerprofilesctl", "set", "performance"], capture_output=True, timeout=3)
            print("[AutoPower] CPU → performance", flush=True)
        except Exception:
            pass

        # 5. ASUS profile: Performance (Bung xõa toàn bộ sức mạnh quạt)
        set_asus_profile("Performance")

        # 6. Khôi phục đèn bàn phím RGB
        set_keyboard_backlight("med")

        # 7. Bluetooth BẬT
        set_bluetooth(True)

        # 8. Khôi phục độ sáng 100%
        set_brightness_percent(AC_BRIGHTNESS_PERCENT)

        # 9. Bật thông báo trở lại
        set_notifications(True)

        # 10. Thông báo người dùng
        subprocess.run([
            "notify-send", "-u", "low", "-i", "ac-adapter",
            "⚡ Đã cắm sạc — Performance 144Hz",
            "144Hz • Hiệu năng tối đa • Khôi phục toàn bộ giao diện & AI"
        ], capture_output=True)

# ──────────────────────────────────────────────────────────────
# Main loop
# ──────────────────────────────────────────────────────────────
def main():
    print("[AutoPower] Starting ASUS TUF Power Manager v3.5 (Instant AI GPU & Active Anti-Heat Airflow)...", flush=True)
    clean_stale_singleton_locks()
    clean_quickshell_ramdisk()

    last_ac               = None
    hyprland_synced_state = None
    loop_tick             = 0
    CHECK_INTERVAL        = 1  # 1 second for instant AI/GPU detection

    while True:
        try:
            loop_tick += 1
            if loop_tick >= 30:
                loop_tick = 0
                clean_quickshell_ramdisk()

            ac = is_ac_online()

            # Detect state change or initial startup
            if last_ac is None or ac != last_ac:
                last_ac = ac
                # Reset manual override on AC plug/unplug so profile matches power source
                if os.path.exists(OVERRIDE_FILE):
                    try:
                        os.unlink(OVERRIDE_FILE)
                    except Exception:
                        pass
                on_power_state_change(ac)
                hyprland_synced_state = ac

            # Ensure Hyprland refresh rate & effects are synced if Hyprland was delayed during boot
            if hyprland_synced_state != ac:
                if ensure_hyprland_env():
                    if set_refresh_rate(144 if ac else 60) and configure_hyprland_effects(ac):
                        hyprland_synced_state = ac

            cur = get_current_asus_profile()

            # Check manual override from asus-fan-toggle
            override = get_manual_override()
            if override:
                if cur != override:
                    set_asus_profile(override)
                time.sleep(CHECK_INTERVAL)
                continue

            cpu_temp = get_cpu_temp()

            if ac:
                # AC Mode: CHỐNG ÁM NHIỆT KHUNG SƯỜN & PHÁT HIỆN TẢI AI TỨC THÌ
                gpu_temp, gpu_util = get_gpu_status()
                max_temp = max(cpu_temp, gpu_temp)

                # 1. Phát hiện chạy AI / CUDA / Đồ họa (GPU util > 15% hoặc GPU temp >= 58°C hoặc CPU >= 65°C):
                if gpu_util > 15 or gpu_temp >= 58.0 or max_temp >= 65.0:
                    if cur != "Performance":
                        set_asus_profile("Performance")
                        print(f"[AutoPower] 🔥 Tải cao / AI chạy tức thì (CPU: {cpu_temp:.1f}°C, GPU: {gpu_temp:.1f}°C, Util: {gpu_util}%) → Performance (Turbo Airflow)", flush=True)

                # 2. Duy trì lưu lượng gió chống ám nhiệt vào khung sườn khi lướt web / làm việc:
                elif max_temp >= 50.0:
                    if cur not in ["Performance", "Balanced"]:
                        set_asus_profile("Balanced")
                        print(f"[AutoPower] 🌬️ Duy trì gió chủ động chống ám nhiệt khung sườn (Max: {max_temp:.1f}°C) → Balanced", flush=True)

                # 3. Chỉ khi máy thực sự siêu mát và nhàn rỗi (< 45°C) mới hạ về Balanced êm
                elif max_temp <= 44.0:
                    if cur != "Balanced":
                        set_asus_profile("Balanced")
                        print(f"[AutoPower] ❄️ Máy siêu mát ({max_temp:.1f}°C ≤ 44°C) → Balanced êm ái", flush=True)

            else:
                # Battery Mode: Tiết kiệm pin tối đa
                # Không poll NVML để GPU rơi vào D3cold (0.0W)
                max_temp = cpu_temp
                if max_temp >= 75.0 and cur != "Performance":
                    set_asus_profile("Performance")
                    print(f"[AutoPower] ⚠️ Pin nhưng nhiệt cao (Max: {max_temp:.1f}°C) → Cứu nguy Performance", flush=True)
                elif max_temp <= 55.0 and cur != "Quiet":
                    set_asus_profile("Quiet")
                    print(f"[AutoPower] ❄️ Pin máy mát ({max_temp:.1f}°C ≤ 55°C) → Quiet (0 RPM)", flush=True)

        except Exception as e:
            print(f"[AutoPower] Loop exception: {e}", file=sys.stderr, flush=True)

        time.sleep(CHECK_INTERVAL)

if __name__ == "__main__":
    main()
