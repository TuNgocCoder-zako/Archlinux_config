def get_hardware_temperatures():
    """Returns (cpu_temp, vrm_temp, nvme_temp) in Celsius."""
    cpu_temp = 50.0
    vrm_temp = 45.0
    nvme_temp = 45.0
    for path in glob.glob("/sys/class/hwmon/hwmon*"):
        try:
            with open(os.path.join(path, "name")) as f:
                name = f.read().strip()
            if name == "coretemp":
                with open(os.path.join(path, "temp1_input")) as tf:
                    cpu_temp = int(tf.read().strip()) / 1000.0
            elif name == "acpitz":
                # temp1 is motherboard VRM / left chassis area directly under WASD
                with open(os.path.join(path, "temp1_input")) as tf:
                    vrm_temp = int(tf.read().strip()) / 1000.0
            elif name == "nvme":
                # temp1 is Composite temperature of primary M.2 NVMe SSD
                with open(os.path.join(path, "temp1_input")) as tf:
                    nvme_temp = int(tf.read().strip()) / 1000.0
        except Exception:
            pass
    return cpu_temp, vrm_temp, nvme_temp

def get_cpu_temp():
    cpu, _, _ = get_hardware_temperatures()
    return cpu

def is_ac_online():
    """Check if any external AC/Mains/USB-C charger is online."""
    for p in glob.glob("/sys/class/power_supply/*"):
        try:
            with open(os.path.join(p, "type")) as tf:
                stype = tf.read().strip()
            if stype in ["Mains", "USB"]:
                with open(os.path.join(p, "online")) as of:
                    if of.read().strip() == "1":
                        return True
        except Exception:
            pass
    return False

# ──────────────────────────────────────────────────────────────
# NVIDIA GPU Sensor via fast NVML (ctypes, <0.1ms)
# ──────────────────────────────────────────────────────────────
_nvml_handle = None
_nvml_initialized = False
_last_nvml_idle_time = 0.0

class _NvmlUtilization(ctypes.Structure):
    _fields_ = [("gpu", ctypes.c_uint), ("memory", ctypes.c_uint)]

class _NvmlMemory(ctypes.Structure):
    _fields_ = [("total", ctypes.c_ulonglong), ("free", ctypes.c_ulonglong), ("used", ctypes.c_ulonglong)]

def _init_nvml():
    global _nvml_handle, _nvml_initialized
    if _nvml_initialized:
        return _nvml_handle is not None
    _nvml_initialized = True
    try:
        lib = ctypes.CDLL("libnvidia-ml.so.1")
        if lib.nvmlInit_v2() == 0:
            dev = ctypes.c_void_p()
            if lib.nvmlDeviceGetHandleByIndex_v2(0, ctypes.byref(dev)) == 0:
                _nvml_handle = (lib, dev)
                return True
    except Exception:
        pass
    return False

def shutdown_nvml():
    """Release NVML handle so NVIDIA dGPU can enter D3cold (0.0W)."""
    global _nvml_handle, _nvml_initialized
    if _nvml_handle:
        try:
            lib, _ = _nvml_handle
            lib.nvmlShutdown()
        except Exception:
            pass
        _nvml_handle = None
    _nvml_initialized = False

def get_gpu_pci_status():
    """Reads Linux PCI runtime_status without waking GPU. Returns 'suspended', 'active', etc."""
    try:
        with open("/sys/bus/pci/devices/0000:01:00.0/power/runtime_status", "r") as f:
            return f.read().strip()
    except Exception:
        return "unknown"

def get_gpu_status():
    """Returns (gpu_temp_c, gpu_util_pct, gpu_used_mem_mb). Fast, zero subprocess, never wakes sleeping GPU."""
    global _last_nvml_idle_time
    pci_status = get_gpu_pci_status()
    if pci_status == "suspended":
        # GPU is sleeping in D3cold (0W). Do not wake it up with NVML!
        if _nvml_handle:
            shutdown_nvml()
        return 0.0, 0, 0

    # Cooldown: nếu GPU rảnh và vừa shutdown NVML, dành tối thiểu 15s im lặng tuyệt đối
    # để Linux PCI driver đếm ngược autosuspend_delay đưa GPU về D3cold (0.0W).
    now = time.time()
    if now - _last_nvml_idle_time < 15.0:
        return 0.0, 0, 0

    if not _init_nvml() or not _nvml_handle:
        return 0.0, 0, 0
    lib, dev = _nvml_handle
    try:
        temp = ctypes.c_uint()
        if lib.nvmlDeviceGetTemperature(dev, 0, ctypes.byref(temp)) == 0:
            gpu_temp = float(temp.value)
        else:
            gpu_temp = 0.0
        util = _NvmlUtilization()
        if lib.nvmlDeviceGetUtilizationRates(dev, ctypes.byref(util)) == 0:
            gpu_util = int(util.gpu)
        else:
            gpu_util = 0

        mem = _NvmlMemory()
        if lib.nvmlDeviceGetMemoryInfo(dev, ctypes.byref(mem)) == 0:
            gpu_used_mem_mb = int(mem.used // (1024 * 1024))
        else:
            gpu_used_mem_mb = 0

        # Nếu GPU rảnh và không có VRAM model lớn, ngắt NVML ngay và bắt đầu cooldown 15s để GPU ngủ D3cold
        if gpu_util == 0 and gpu_used_mem_mb < 300:
            shutdown_nvml()
            _last_nvml_idle_time = now

        return gpu_temp, gpu_util, gpu_used_mem_mb
    except Exception:
        return 0.0, 0, 0

OVERRIDE_FILE = "/tmp/asus-fan-override.json"

def get_manual_override():
    """Check if user manually toggled fan profile recently."""
    try:
        if os.path.exists(OVERRIDE_FILE):
            with open(OVERRIDE_FILE, "r") as f:
                data = json.load(f)
            # Override valid for 30 minutes (1800s)
            if time.time() - data.get("timestamp", 0) < 1800:
                return data.get("profile")
    except Exception:
        pass
    return None

