BATTERY_BRIGHTNESS_PERCENT = 40   # % of max when on battery (tiết kiệm ~3W)
AC_BRIGHTNESS_PERCENT      = 100  # % of max when on AC (restore)

def get_max_brightness():
    try:
        result = subprocess.run(["brightnessctl", "max"], capture_output=True, text=True, timeout=2)
        return int(result.stdout.strip())
    except Exception:
        return 96000  # fallback for this machine

def set_brightness_percent(percent):
    """Set brightness to a given % of max."""
    try:
        max_b = get_max_brightness()
        target = int(max_b * percent / 100)
        subprocess.run(["brightnessctl", "set", str(target)], capture_output=True, timeout=3)
        print(f"[AutoPower] Brightness set to {percent}% ({target}/{max_b})", flush=True)
    except Exception as e:
        print(f"[AutoPower] Brightness error: {e}", file=sys.stderr, flush=True)

