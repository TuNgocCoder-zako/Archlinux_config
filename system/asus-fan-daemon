def set_bluetooth(enabled: bool):
    try:
        if enabled:
            subprocess.run(["rfkill", "unblock", "bluetooth"], capture_output=True, timeout=3)
            time.sleep(0.3)
            subprocess.run(["bluetoothctl", "power", "on"], capture_output=True, timeout=5)
        else:
            subprocess.run(["bluetoothctl", "power", "off"], capture_output=True, timeout=5)
        state = "BẬT" if enabled else "TẮT"
        print(f"[AutoPower] Bluetooth → {state}", flush=True)
    except Exception as e:
        print(f"[AutoPower] Bluetooth error: {e}", file=sys.stderr, flush=True)

