def configure_caelestia(ac_online: bool, force_reload: bool = False):
    """
    Dynamically tune Caelestia Shell:
    - Khi CẮM SẠC (AC): Bật đầy đủ giao diện & hiệu ứng (Dashboard, Taskbar cố định,
      Hình nền, Cava sóng nhạc nền, Desktop Clock, Spotify/GitHub widgets).
    - Khi DÙNG PIN (Battery): Chế độ tiết kiệm cực đoan chống sụt áp pin chai:
      Tắt hoàn toàn Taskbar & Dashboard để khi lia chuột không bị kích hoạt render gây sụt áp,
      tắt Hình nền, tắt Cava/visualiser, tạm dừng video wallpaper.
    - Shimeji con mèo: Luôn tắt vĩnh viễn (người dùng không dùng).
    """
    try:
        if not os.path.exists(SHELL_CONFIG_PATH):
            return
        with open(SHELL_CONFIG_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)

        changed = False

        # 1. Background (Hình nền, Cava, Lyrics, Clock): Bật khi AC, Tắt khi Dùng Pin (chống sụt áp pin chai)
        bg = data.setdefault("background", {})
        if bg.get("enabled") != ac_online:
            bg["enabled"] = ac_online
            changed = True

        if bg.get("wallpaperEnabled") != ac_online:
            bg["wallpaperEnabled"] = ac_online
            changed = True

        if bg.setdefault("visualiser", {}).get("enabled") != ac_online:
            bg["visualiser"]["enabled"] = ac_online
            changed = True

        if bg.setdefault("desktopLyrics", {}).get("enabled") != ac_online:
            bg["desktopLyrics"]["enabled"] = ac_online
            changed = True

        if bg.setdefault("desktopClock", {}).get("enabled") != ac_online:
            bg["desktopClock"]["enabled"] = ac_online
            changed = True

        target_video_pause = not ac_online
        if bg.get("videoWallpaperPaused") != target_video_pause:
            bg["videoWallpaperPaused"] = target_video_pause
            changed = True

        # 2. Shimeji con mèo: LUÔN TẮT HOÀN TOÀN (Người dùng không dùng mèo Shimeji)
        shimeji = data.setdefault("shimeji", {})
        if shimeji.get("enabled") is not False:
            shimeji["enabled"] = False
            changed = True

        # 3. Taskbar (Bar / Dock): BẬT KHI CẮM SẠC, TẮT HOÀN TOÀN KHI DÙNG PIN (tránh lia chuột sụt áp)
        bar = data.setdefault("bar", {})
        target_bar_persistent = ac_online
        if bar.get("persistent") != target_bar_persistent:
            bar["persistent"] = target_bar_persistent
            changed = True

        if bar.get("showOnHover", False):
            bar["showOnHover"] = False
            changed = True

        target_excluded_screens = [] if ac_online else ["eDP-1", "^.*$"]
        if bar.get("excludedScreens") != target_excluded_screens:
            bar["excludedScreens"] = target_excluded_screens
            changed = True

        # Đồng bộ cấu hình screens riêng nếu có
        for s_name, s_conf in data.get("screens", {}).items():
            if isinstance(s_conf, dict) and "bar" in s_conf:
                if s_conf["bar"].get("persistent") != target_bar_persistent:
                    s_conf["bar"]["persistent"] = target_bar_persistent
                    changed = True
                if s_conf["bar"].get("excludedScreens") != target_excluded_screens:
                    s_conf["bar"]["excludedScreens"] = target_excluded_screens
                    changed = True

        # Widgets phụ trên bar (Spotify, GitHub): Bật khi AC, Tắt khi pin
        entries = bar.setdefault("entries", {})
        for item in entries.setdefault("start", []):
            if item.get("id") == "spotify" and item.get("enabled") != ac_online:
                item["enabled"] = ac_online
                changed = True
        for item in entries.setdefault("end", []):
            if item.get("id") == "github" and item.get("enabled") != ac_online:
                item["enabled"] = ac_online
                changed = True

        # 4. Dashboard: BẬT KHI CẮM SẠC, TẮT KHI DÙNG PIN (chống lia chuột lên mép trên bị sụt áp)
        dash = data.setdefault("dashboard", {})
        if dash.get("enabled") != ac_online:
            dash["enabled"] = ac_online
            changed = True
        if dash.get("showOnHover") != ac_online:
            dash["showOnHover"] = ac_online
            changed = True
        if dash.get("showDashboard") != ac_online:
            dash["showDashboard"] = ac_online
            changed = True

        # Sidebar & Utilities & Launcher: Luôn bật sẵn sàng
        sidebar = data.setdefault("sidebar", {})
        if not sidebar.get("enabled", True):
            sidebar["enabled"] = True
            changed = True

        utils = data.setdefault("utilities", {})
        if not utils.get("enabled", True):
            utils["enabled"] = True
            changed = True

        launcher = data.setdefault("launcher", {})
        if not launcher.get("enabled", True):
            launcher["enabled"] = True
            changed = True

        if changed or force_reload:
            with open(SHELL_CONFIG_PATH, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=4)
            mode_str = "AC (Dashboard, Taskbar & Hiệu ứng: BẬT)" if ac_online else "BATTERY (Dashboard, Taskbar & Hình nền: TẮT chống sụt áp)"
            print(f"[AutoPower] Caelestia shell.json updated -> {mode_str}, reloading shell...", flush=True)
            reload_caelestia()
            print("[AutoPower] Caelestia shell reloaded successfully", flush=True)
        else:
            mode_str = "AC" if ac_online else "BATTERY"
            print(f"[AutoPower] Caelestia shell already in target state ({mode_str})", flush=True)
    except Exception as e:
        print(f"[AutoPower] Caelestia config error: {e}", file=sys.stderr, flush=True)


