STUDY_CONTAINERS = ["local_mysql", "local_phpmyadmin"]

def manage_background_tasks(ac_online):
    # Luôn giữ MySQL và phpMyAdmin hoạt động liên tục phục vụ học tập (chỉ ăn ~0.01% CPU)
    for c in STUDY_CONTAINERS:
        try:
            res = subprocess.run(["docker", "inspect", "-f", "{{.State.Status}}", c], capture_output=True, text=True, timeout=2)
            if res.stdout.strip() == "paused":
                print(f"[AutoPower] Unpausing {c} để đảm bảo học tập không bị ngắt quãng...", flush=True)
                subprocess.run(["docker", "unpause", c], capture_output=True, timeout=5)
        except Exception:
            pass

    if not ac_online:
        # Chỉ tắt Ollama AI container khi dùng pin (Ollama ăn nhiều RAM/CPU)
        try:
            res = subprocess.run(
                ["docker", "ps", "-q", "-f", "name=ollama"],
                capture_output=True, text=True, timeout=2
            )
            if res.stdout.strip():
                print("[AutoPower] Battery: Stopping Ollama AI container...", flush=True)
                subprocess.run(["docker", "stop", "ollama"], capture_output=True, timeout=10)
        except Exception:
            pass

        # Kill hanging trash-empty or stale python loops
        for proc in ["trash-empty", "optimize-system.sh"]:
            try:
                subprocess.run(["pkill", "-f", proc], capture_output=True)
            except Exception:
                pass

        # Kill any voice-ai daemon if running
        try:
            subprocess.run(["pkill", "-f", "voice-ai"], capture_output=True)
        except Exception:
            pass

    else:
        # Restore Ollama AI container on AC
        try:
            res_all = subprocess.run(
                ["docker", "ps", "-a", "-q", "-f", "name=ollama"],
                capture_output=True, text=True, timeout=2
            )
            if res_all.stdout.strip():
                res_run = subprocess.run(
                    ["docker", "ps", "-q", "-f", "name=ollama"],
                    capture_output=True, text=True, timeout=2
                )
                if not res_run.stdout.strip():
                    print("[AutoPower] AC: Resuming Ollama AI container...", flush=True)
                    subprocess.run(["docker", "start", "ollama"], capture_output=True, timeout=10)
        except Exception:
            pass

