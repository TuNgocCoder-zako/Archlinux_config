# ──────────────────────────────────────────────────────────────
# Main loop
# ──────────────────────────────────────────────────────────────
def main():
    print("[AutoPower] Starting ASUS TUF Power Manager v3.5 (Instant AI GPU & Active Anti-Heat Airflow)...", flush=True)
    clean_stale_singleton_locks()
    clean_quickshell_ramdisk()
    set_battery_charge_limit(80)
    set_bluetooth(True)

    last_ac               = None
    hyprland_synced_state = None
    loop_tick             = 0
    last_gpu_util         = 0
    last_gpu_temp         = 0.0
    last_gpu_mem          = 0
    high_load_ticks       = 0
    cool_ticks            = 0
    battery_high_ticks    = 0
    battery_cool_ticks    = 0
    CHECK_INTERVAL        = 1  # 1 second for instant AI/GPU detection

    while True:
        try:
            loop_tick += 1
            if loop_tick >= 30:
                loop_tick = 0
                clean_quickshell_ramdisk()

            ac = is_ac_online()

            # Detect state change or initial startup
            if last_ac is None or ac != last_ac:
                last_ac = ac
                high_load_ticks = 0
                cool_ticks = 0
                battery_high_ticks = 0
                battery_cool_ticks = 0
                # Reset manual override on AC plug/unplug so profile matches power source
                if os.path.exists(OVERRIDE_FILE):
                    try:
                        os.unlink(OVERRIDE_FILE)
                    except Exception:
                        pass
                on_power_state_change(ac)
                hyprland_synced_state = ac

            # Ensure Hyprland refresh rate & effects are synced if Hyprland was delayed during boot
            if hyprland_synced_state != ac:
                if ensure_hyprland_env():
                    if set_refresh_rate(144 if ac else 60) and configure_hyprland_effects(ac):
                        hyprland_synced_state = ac

            cur = get_current_asus_profile()

            # Check manual override from asus-fan-toggle
            override = get_manual_override()
            if override:
                if cur != override:
                    set_asus_profile(override)
                time.sleep(CHECK_INTERVAL)
                continue

            cpu_temp, vrm_temp, nvme_temp = get_hardware_temperatures()

            if ac:
                # AC Mode: CHỐNG ÁM NHIỆT KHUNG SƯỜN & PHÁT HIỆN TẢI AI TỨC THÌ
                # Nếu GPU đang ở D3cold (suspended), tuyệt đối không poll NVML để GPU giữ nguyên 0.0W
                if get_gpu_pci_status() == "suspended":
                    gpu_temp, gpu_util, gpu_mem = 0.0, 0, 0
                    last_gpu_util, last_gpu_temp, last_gpu_mem = 0, 0.0, 0
                elif loop_tick % 5 == 0 or last_gpu_util > 0 or last_gpu_mem > 300:
                    gpu_temp, gpu_util, gpu_mem = get_gpu_status()
                    last_gpu_util = gpu_util
                    last_gpu_temp = gpu_temp
                    last_gpu_mem = gpu_mem
                else:
                    gpu_temp, gpu_util, gpu_mem = last_gpu_temp, last_gpu_util, last_gpu_mem

                # ĐIỀU TỐC THÔNG MINH TRÊN AC:
                # Mặc định duy trì Balanced (CPU idle 800MHz ăn 1.5W mát rượi, EPP balance_performance).
                # Chỉ kích hoạt Performance khi máy bắt đầu ấm (CPU >= 70°C hoặc VRM >= 64°C hoặc GPU tải > 20%)
                # để tăng quạt lên 3500+ RPM giải nhiệt tức thì, sau đó tự hạ về Balanced.
                is_high_load = (
                    (cpu_temp >= 70.0) or
                    (vrm_temp >= 64.0) or
                    (gpu_temp >= 65.0) or
                    (gpu_util > 20)
                )

                is_cool_load = (
                    (cpu_temp < 60.0) and
                    (vrm_temp < 56.0) and
                    (gpu_temp < 55.0) and
                    (gpu_util <= 5)
                )

                if is_high_load:
                    high_load_ticks += 1
                    cool_ticks = 0
                    if high_load_ticks >= 3:
                        if cur != "Performance":
                            set_asus_profile("Performance")
                            print(f"[AutoPower] 🔥 Tải cao / Nhiệt tăng (CPU: {cpu_temp:.1f}°C, VRM: {vrm_temp:.1f}°C, GPU util: {gpu_util}%) → Performance (Turbo Airflow)", flush=True)
                elif is_cool_load:
                    cool_ticks += 1
                    high_load_ticks = 0
                    if cool_ticks >= 4:
                        if cur != "Balanced":
                            set_asus_profile("Balanced")
                            print(f"[AutoPower] 🌬️ Máy đã nguội (CPU: {cpu_temp:.1f}°C, VRM: {vrm_temp:.1f}°C) → Balanced (CPU 800MHz mát rượi)", flush=True)
                else:
                    high_load_ticks = 0
                    cool_ticks = 0

            else:
                # Battery Mode: Tiết kiệm pin tối đa
                # Không poll NVML để GPU rơi vào D3cold (0.0W)
                if cpu_temp >= 75.0 or vrm_temp >= 62.0:
                    battery_high_ticks += 1
                    battery_cool_ticks = 0
                    if battery_high_ticks >= 3:
                        if cur != "Performance":
                            set_asus_profile("Performance")
                            print(f"[AutoPower] ⚠️ Pin nhiệt cao liên tục (CPU: {cpu_temp:.1f}°C, VRM: {vrm_temp:.1f}°C) → Cứu nguy Performance", flush=True)
                elif cpu_temp <= 55.0 and vrm_temp <= 50.0:
                    battery_cool_ticks += 1
                    battery_high_ticks = 0
                    if battery_cool_ticks >= 10:
                        if cur != "Quiet":
                            set_asus_profile("Quiet")
                            print(f"[AutoPower] ❄️ Pin máy mát (CPU: {cpu_temp:.1f}°C, VRM: {vrm_temp:.1f}°C) → Quiet (0 RPM)", flush=True)
                else:
                    battery_high_ticks = 0
                    battery_cool_ticks = 0

        except Exception as e:
            print(f"[AutoPower] Loop exception: {e}", file=sys.stderr, flush=True)

        time.sleep(CHECK_INTERVAL)

if __name__ == "__main__":
    main()
