def configure_caelestia(ac_online: bool):
    """
    Dynamically tune Caelestia Shell:
    - Khi CẮM SẠC (AC): Bật đầy đủ hiệu ứng (Thanh Taskbar/Dock, Hình nền, Cava sóng nhạc nền,
      Shimeji con mèo, Desktop Lyrics, Desktop Clock, Spotify/GitHub widgets, Video wallpaper).
    - Khi DÙNG PIN (Battery): Tắt hoàn toàn Taskbar/Dock, tắt hoàn toàn Hình nền, tắt Cava,
      Shimeji, Lyrics, Clock để giao diện đen kịt/siêu nhẹ, tối đa hóa thời lượng pin.
    """
    try:
        if not os.path.exists(SHELL_CONFIG_PATH):
            return
        with open(SHELL_CONFIG_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)

        changed = False

        # 1. Background (Hình nền, Cava, Lyrics, Clock): CHỈ BẬT KHI CẮM SẠC, TẮT HOÀN TOÀN KHI DÙNG PIN
        bg = data.setdefault("background", {})
        if bg.get("enabled") != ac_online:
            bg["enabled"] = ac_online
            changed = True

        if bg.get("wallpaperEnabled") != ac_online:
            bg["wallpaperEnabled"] = ac_online
            changed = True

        if bg.setdefault("visualiser", {}).get("enabled") != ac_online:
            bg["visualiser"]["enabled"] = ac_online
            changed = True

        if bg.setdefault("desktopLyrics", {}).get("enabled") != ac_online:
            bg["desktopLyrics"]["enabled"] = ac_online
            changed = True

        if bg.setdefault("desktopClock", {}).get("enabled") != ac_online:
            bg["desktopClock"]["enabled"] = ac_online
            changed = True

        target_video_pause = not ac_online
        if bg.get("videoWallpaperPaused") != target_video_pause:
            bg["videoWallpaperPaused"] = target_video_pause
            changed = True

        # 2. Shimeji con mèo: CHỈ BẬT KHI CẮM SẠC, TẮT KHI DÙNG PIN
        shimeji = data.setdefault("shimeji", {})
        if shimeji.get("enabled") != ac_online:
            shimeji["enabled"] = ac_online
            changed = True

        if shimeji.get("autoHide") is not False:
            shimeji["autoHide"] = False
            changed = True

        if shimeji.get("path") != "root:/assets/shimeji/pusheen":
            shimeji["path"] = "root:/assets/shimeji/pusheen"
            changed = True

        if shimeji.get("count") != 1:
            shimeji["count"] = 1
            changed = True

        # 3. Taskbar (Bar / Dock): BẬT KHI CẮM SẠC, TẮT HOÀN TOÀN KHI DÙNG PIN
        bar = data.setdefault("bar", {})
        target_bar_persistent = ac_online
        if bar.get("persistent") != target_bar_persistent:
            bar["persistent"] = target_bar_persistent
            changed = True

        if bar.get("showOnHover", False):
            bar["showOnHover"] = False
            changed = True

        target_excluded_screens = [] if ac_online else ["^.*$"]
        if bar.get("excludedScreens") != target_excluded_screens:
            bar["excludedScreens"] = target_excluded_screens
            changed = True

        # Widgets phụ trên bar (Spotify, GitHub): Bật khi AC, Tắt khi pin
        entries = bar.setdefault("entries", {})
        for item in entries.setdefault("start", []):
            if item.get("id") == "spotify" and item.get("enabled") != ac_online:
                item["enabled"] = ac_online
                changed = True
        for item in entries.setdefault("end", []):
            if item.get("id") == "github" and item.get("enabled") != ac_online:
                item["enabled"] = ac_online
                changed = True

        # 4. Dashboard & Utilities & Launcher: Luôn bật sẵn sàng
        dash = data.setdefault("dashboard", {})
        if not dash.get("enabled", True):
            dash["enabled"] = True
            changed = True

        sidebar = data.setdefault("sidebar", {})
        if not sidebar.get("enabled", True):
            sidebar["enabled"] = True
            changed = True

        utils = data.setdefault("utilities", {})
        if not utils.get("enabled", True):
            utils["enabled"] = True
            changed = True

        launcher = data.setdefault("launcher", {})
        if not launcher.get("enabled", True):
            launcher["enabled"] = True
            changed = True

        if changed:
            with open(SHELL_CONFIG_PATH, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=4)
            mode_str = "AC (Hiệu ứng & Shimeji: BẬT)" if ac_online else "BATTERY (Hiệu ứng & Shimeji: TẮT, Tiết kiệm pin)"
            print(f"[AutoPower] Caelestia shell.json updated -> {mode_str}, reloading shell...", flush=True)
            reload_caelestia()
            print("[AutoPower] Caelestia shell reloaded successfully", flush=True)
        else:
            mode_str = "AC" if ac_online else "BATTERY"
            print(f"[AutoPower] Caelestia shell already in target state ({mode_str})", flush=True)
    except Exception as e:
        print(f"[AutoPower] Caelestia config error: {e}", file=sys.stderr, flush=True)


