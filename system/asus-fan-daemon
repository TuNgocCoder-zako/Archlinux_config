SHELL_CONFIG_PATH = os.path.expanduser("~/Archlinux_config/dotfiles/caelestia/shell.json")

def ensure_hyprland_env():
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if sig:
        sock_path = f"/run/user/{os.getuid()}/hypr/{sig}/.socket.sock"
        if os.path.exists(sock_path):
            return True

    candidates = []
    for p in glob.glob(f"/run/user/{os.getuid()}/hypr/*_*"):
        if os.path.isdir(p) and os.path.exists(os.path.join(p, ".socket.sock")):
            candidates.append((os.path.getmtime(p), os.path.basename(p)))
    if candidates:
        candidates.sort(reverse=True)
        os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = candidates[0][1]
        return True
    return False

def set_refresh_rate(hz):
    """Switch eDP-1 refresh rate using hyprctl eval + hl.monitor() (Lua parser)."""
    if not ensure_hyprland_env():
        return False
    lua_cmd = f'hl.monitor({{ output = "eDP-1", mode = "1920x1080@{hz}", position = "0x0", scale = 1 }})'
    try:
        result = subprocess.run(
            ["hyprctl", "eval", lua_cmd],
            capture_output=True, text=True, timeout=5
        )
        if result.returncode == 0 and "ok" in result.stdout.lower():
            print(f"[AutoPower] Display → {hz}Hz", flush=True)
            return True
        else:
            print(f"[AutoPower] Display {hz}Hz error: {result.stderr.strip() or result.stdout.strip()}", file=sys.stderr, flush=True)
            return False
    except Exception as e:
        print(f"[AutoPower] Display switch error: {e}", file=sys.stderr, flush=True)
        return False

def configure_hyprland_effects(ac_online: bool):
    """Dynamically adjust compositor performance & rendering based on power state."""
    if not ensure_hyprland_env():
        return False
    direct_scanout = 1
    render_scheduling = "true"  # Luôn giữ true để loại bỏ 100% độ trễ gõ chữ và input lag
    anim_enabled = "true" if ac_online else "false"  # Tắt trên pin để GPU không tốn xung nhịp chuyển động
    blur_enabled = "true" if ac_online else "false"
    blur_passes = 1  # 1 pass Dual-Kawase: Giảm 50% shader load, mượt tuyệt đối trên Intel iGPU
    blur_size = 4
    xray_val = "true"
    shadow_enabled = "true" if ac_online else "false"
    shadow_range = 8 if ac_online else 0
    shadow_power = 2
    lua_cmd = (
        f'hl.config({{ '
        f'render = {{ direct_scanout = {direct_scanout}, new_render_scheduling = {render_scheduling} }}, '
        f'animations = {{ enabled = {anim_enabled} }}, '
        f'decoration = {{ shadow = {{ enabled = {shadow_enabled}, range = {shadow_range}, render_power = {shadow_power} }}, '
        f'blur = {{ enabled = {blur_enabled}, passes = {blur_passes}, size = {blur_size}, xray = {xray_val}, new_optimizations = true }} }} '
        f'}})'
    )
    try:
        res = subprocess.run(["hyprctl", "eval", lua_cmd], capture_output=True, text=True, timeout=3)
        if res.returncode == 0 and "ok" in res.stdout.lower():
            state = f"AC 144Hz (shadow=on, blur=1pass, anim=on)" if ac_online else f"Battery Eco 60Hz (shadow=off, blur=off, anim=off - chống sụt áp)"
            print(f"[AutoPower] Hyprland tuning → {state}", flush=True)
            return True
        return False
    except Exception as e:
        print(f"[AutoPower] Hyprland decoration error: {e}", file=sys.stderr, flush=True)
        return False

def reload_caelestia():
    """Reliably restart QuickShell using Hyprland's native dispatcher with Intel Mesa isolation."""
    ensure_hyprland_env()
    try:
        my_pid = os.getpid()
        # 1. Kill any existing quickshell caelestia processes by PID directly (never hang on IPC)
        res = subprocess.run(["pgrep", "-f", "qs -c caelestia"], capture_output=True, text=True)
        for p in res.stdout.strip().split():
            if p.isdigit() and int(p) != my_pid:
                try:
                    os.kill(int(p), 9)
                except OSError:
                    pass

        # 2. Kill any hung caelestia CLI/IPC wrappers
        res2 = subprocess.run(["pgrep", "-f", "caelestia shell"], capture_output=True, text=True)
        for p in res2.stdout.strip().split():
            if p.isdigit() and int(p) != my_pid:
                try:
                    os.kill(int(p), 9)
                except OSError:
                    pass

        time.sleep(0.3)

        # 3. Launch fresh instance on Intel Iris Xe
        subprocess.run(
            ["hyprctl", "eval", 'hl.dispatch(hl.dsp.exec_cmd("caelestia-intel"))'],
            capture_output=True, timeout=5
        )
        print("[AutoPower] Caelestia shell relaunched successfully via Intel Mesa", flush=True)
    except Exception as e:
        print(f"[AutoPower] reload_caelestia error: {e}", file=sys.stderr, flush=True)

