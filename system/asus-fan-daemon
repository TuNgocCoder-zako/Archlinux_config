def get_cpu_temp():
    for path in glob.glob("/sys/class/hwmon/hwmon*"):
        try:
            with open(os.path.join(path, "name")) as f:
                if f.read().strip() == "coretemp":
                    with open(os.path.join(path, "temp1_input")) as tf:
                        return int(tf.read().strip()) / 1000.0
        except Exception:
            pass
    try:
        with open("/sys/class/thermal/thermal_zone0/temp") as f:
            return int(f.read().strip()) / 1000.0
    except Exception:
        return 50.0

def is_ac_online():
    """Check if any external AC/Mains/USB-C charger is online."""
    for p in glob.glob("/sys/class/power_supply/*"):
        try:
            with open(os.path.join(p, "type")) as tf:
                stype = tf.read().strip()
            if stype in ["Mains", "USB"]:
                with open(os.path.join(p, "online")) as of:
                    if of.read().strip() == "1":
                        return True
        except Exception:
            pass
    return False

# ──────────────────────────────────────────────────────────────
# NVIDIA GPU Sensor via fast NVML (ctypes, <0.1ms)
# ──────────────────────────────────────────────────────────────
_nvml_handle = None
_nvml_initialized = False

class _NvmlUtilization(ctypes.Structure):
    _fields_ = [("gpu", ctypes.c_uint), ("memory", ctypes.c_uint)]

def _init_nvml():
    global _nvml_handle, _nvml_initialized
    if _nvml_initialized:
        return _nvml_handle is not None
    _nvml_initialized = True
    try:
        lib = ctypes.CDLL("libnvidia-ml.so.1")
        if lib.nvmlInit_v2() == 0:
            dev = ctypes.c_void_p()
            if lib.nvmlDeviceGetHandleByIndex_v2(0, ctypes.byref(dev)) == 0:
                _nvml_handle = (lib, dev)
                return True
    except Exception:
        pass
    return False

def shutdown_nvml():
    """Release NVML handle on battery so NVIDIA dGPU can enter D3cold (0.0W)."""
    global _nvml_handle, _nvml_initialized
    if _nvml_handle:
        try:
            lib, _ = _nvml_handle
            lib.nvmlShutdown()
        except Exception:
            pass
        _nvml_handle = None
    _nvml_initialized = False

def get_gpu_status():
    """Returns (gpu_temp_c, gpu_util_pct). Fast, zero subprocess."""
    if not _init_nvml() or not _nvml_handle:
        return 0.0, 0
    lib, dev = _nvml_handle
    try:
        temp = ctypes.c_uint()
        if lib.nvmlDeviceGetTemperature(dev, 0, ctypes.byref(temp)) == 0:
            gpu_temp = float(temp.value)
        else:
            gpu_temp = 0.0
        util = _NvmlUtilization()
        if lib.nvmlDeviceGetUtilizationRates(dev, ctypes.byref(util)) == 0:
            gpu_util = int(util.gpu)
        else:
            gpu_util = 0
        return gpu_temp, gpu_util
    except Exception:
        return 0.0, 0

OVERRIDE_FILE = "/tmp/asus-fan-override.json"

def get_manual_override():
    """Check if user manually toggled fan profile recently."""
    try:
        if os.path.exists(OVERRIDE_FILE):
            with open(OVERRIDE_FILE, "r") as f:
                data = json.load(f)
            # Override valid for 30 minutes (1800s)
            if time.time() - data.get("timestamp", 0) < 1800:
                return data.get("profile")
    except Exception:
        pass
    return None

