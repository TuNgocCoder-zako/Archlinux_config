STUDY_CONTAINERS = ["local_mysql", "local_phpmyadmin"]

def manage_background_tasks(ac_online):
    # Luôn giữ MySQL và phpMyAdmin hoạt động liên tục phục vụ học tập (chỉ ăn ~0.01% CPU)
    for c in STUDY_CONTAINERS:
        try:
            res = subprocess.run(["docker", "inspect", "-f", "{{.State.Status}}", c], capture_output=True, text=True, timeout=2)
            if res.stdout.strip() == "paused":
                print(f"[AutoPower] Unpausing {c} để đảm bảo học tập không bị ngắt quãng...", flush=True)
                subprocess.run(["docker", "unpause", c], capture_output=True, timeout=5)
        except Exception:
            pass

    if not ac_online:
        # Chỉ tắt Ollama AI container khi dùng pin (Ollama ăn nhiều RAM/CPU)
        try:
            res = subprocess.run(
                ["docker", "ps", "-q", "-f", "name=ollama"],
                capture_output=True, text=True, timeout=2
            )
            if res.stdout.strip():
                print("[AutoPower] Battery: Stopping Ollama AI container...", flush=True)
                subprocess.run(["docker", "stop", "ollama"], capture_output=True, timeout=10)
        except Exception:
            pass

        # Kill hanging trash-empty or stale python loops
        for proc in ["trash-empty", "optimize-system.sh"]:
            try:
                subprocess.run(["pkill", "-f", proc], capture_output=True)
            except Exception:
                pass

        # Kill any voice-ai daemon if running
        try:
            subprocess.run(["pkill", "-f", "voice-ai"], capture_output=True)
        except Exception:
            pass

    else:
        # Restore Ollama AI container on AC
        try:
            res_all = subprocess.run(
                ["docker", "ps", "-a", "-q", "-f", "name=ollama"],
                capture_output=True, text=True, timeout=2
            )
            if res_all.stdout.strip():
                res_run = subprocess.run(
                    ["docker", "ps", "-q", "-f", "name=ollama"],
                    capture_output=True, text=True, timeout=2
                )
                if not res_run.stdout.strip():
                    print("[AutoPower] AC: Resuming Ollama AI container...", flush=True)
                    subprocess.run(["docker", "start", "ollama"], capture_output=True, timeout=10)
        except Exception:
            pass

# ──────────────────────────────────────────────────────────────
# Stale SingletonLock cleaner
# ──────────────────────────────────────────────────────────────
def clean_stale_singleton_locks():
    home = os.path.expanduser("~")
    target_dirs = [
        os.path.join(home, ".config", "BraveSoftware", "Brave-Browser"),
        os.path.join(home, ".config", "google-chrome"),
        os.path.join(home, ".config", "chromium"),
        os.path.join(home, ".config", "ZaloData"),
        os.path.join(home, ".config", "discord"),
        os.path.join(home, ".config", "Code"),
    ]
    for d in target_dirs:
        lock_file = os.path.join(d, "SingletonLock")
        if os.path.islink(lock_file) or os.path.exists(lock_file):
            try:
                target = os.readlink(lock_file)
                parts  = target.split("-")
                pid    = int(parts[-1])
                try:
                    os.kill(pid, 0)
                except OSError:
                    print(f"[AutoPower] Cleaning stale lock in {d} (PID {pid} dead)", flush=True)
                    for item in ["SingletonLock", "SingletonCookie", "SingletonSocket"]:
                        p = os.path.join(d, item)
                        if os.path.islink(p) or os.path.exists(p):
                            try:
                                os.unlink(p)
                            except Exception:
                                pass
            except Exception:
                pass

def clean_quickshell_ramdisk():
    """Prevent runaway quickshell/Qt logs from exhausting /run/user/1000 tmpfs."""
    try:
        run_user = "/run/user/1000"
        if not os.path.exists(run_user):
            return

        # 1. Truncate any quickshell log file exceeding 10 MB
        for pattern in ["/run/user/1000/quickshell/by-id/*/*.log", "/run/user/1000/quickshell/by-id/*/*.qslog"]:
            for log_file in glob.glob(pattern):
                try:
                    if os.path.isfile(log_file) and os.path.getsize(log_file) > 10 * 1024 * 1024:
                        os.truncate(log_file, 0)
                        print(f"[AutoPower] Truncated oversized quickshell log: {log_file}", flush=True)
                except Exception:
                    pass

        # 2. Emergency check: if /run/user/1000 exceeds 80% capacity, truncate all logs
        st = os.statvfs(run_user)
        if st.f_blocks > 0:
            used_pct = (1.0 - st.f_bavail / st.f_blocks) * 100
            if used_pct > 80.0:
                print(f"[AutoPower] ⚠️ /run/user/1000 critical ({used_pct:.1f}% used). Truncating quickshell logs...", flush=True)
                for pattern in ["/run/user/1000/quickshell/by-id/*/*.log", "/run/user/1000/quickshell/by-id/*/*.qslog"]:
                    for log_file in glob.glob(pattern):
                        try:
                            if os.path.isfile(log_file):
                                os.truncate(log_file, 0)
                        except Exception:
                            pass
    except Exception:
        pass


