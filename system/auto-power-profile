#!/usr/bin/env bash
# ==============================================================================
# Auto Power Profile & Hardware Optimization Dispatcher (Balanced Smooth)
# ASUS TUF FX506HC: Intel TigerLake GT1 + RTX 3050 + MediaTek MT7921
# ==============================================================================

exec 200>/run/lock/auto-power-profile.lock
flock -n 200 || exit 0
sleep 0.2

is_ac_online() {
    if [ -f /sys/class/power_supply/ACAD/online ]; then
        [ "$(cat /sys/class/power_supply/ACAD/online 2>/dev/null)" = "1" ] && return 0
    fi
    for p in /sys/class/power_supply/*; do
        if [ -f "$p/type" ] && [ -f "$p/online" ]; then
            stype=$(cat "$p/type" 2>/dev/null)
            if [ "$stype" = "Mains" ] || [ "$stype" = "USB" ]; then
                [ "$(cat "$p/online" 2>/dev/null)" = "1" ] && return 0
            fi
        fi
    done
    return 1
}

WIFI_IFACE=$(iw dev 2>/dev/null | awk '$1=="Interface"{print $2}' | head -n 1)
[ -z "$WIFI_IFACE" ] && WIFI_IFACE="wlp45s0"

# ─── GIỚI HẠN SẠC PIN MẶC ĐỊNH 80% (BẢO VỆ TUỔI THỌ PIN ASUS) ───
for bat in /sys/class/power_supply/BAT*/charge_control_end_threshold; do
    [ -f "$bat" ] && echo 80 > "$bat" 2>/dev/null || true
done

if is_ac_online; then
    # ─── ĐANG CẮM SẠC (AC POWER: MAX PERFORMANCE) ───
    echo 0 > /sys/devices/system/cpu/intel_pstate/no_turbo 2>/dev/null || true
    powerprofilesctl set performance >/dev/null 2>&1 || true
    for epp in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
        [ -f "$epp" ] && echo "performance" > "$epp" 2>/dev/null || true
    done

    [ -n "$WIFI_IFACE" ] && iw dev "$WIFI_IFACE" set power_save off >/dev/null 2>&1 || true
    rfkill unblock bluetooth >/dev/null 2>&1 || true
    bluetoothctl power on >/dev/null 2>&1 || true

    for c in /sys/class/drm/card[0-9]*; do
        if [ -f "$c/gt_min_freq_mhz" ] && [ -f "$c/device/vendor" ] && [ "$(cat "$c/device/vendor" 2>/dev/null)" = "0x8086" ]; then
            echo 800 > "$c/gt_min_freq_mhz" 2>/dev/null || true
        fi
    done

    command -v docker >/dev/null 2>&1 && docker unpause local_mysql local_phpmyadmin >/dev/null 2>&1 || true
    logger -t auto-power-profile "Switched to AC Performance Mode (CPU: max, iGPU min: 800MHz, WiFi PS: off, BT: on)"
else
    # ─── ĐANG DÙNG PIN (BATTERY: ENERGY SAVING & SMOOTH 60HZ) ───
    # 1. CPU sang balanced, EPP balance_performance để phản hồi tức thì 0ms không lag phím
    echo 0 > /sys/devices/system/cpu/intel_pstate/no_turbo 2>/dev/null || true
    powerprofilesctl set balanced >/dev/null 2>&1 || true
    sleep 0.1
    for epp in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
        [ -f "$epp" ] && echo "balance_performance" > "$epp" 2>/dev/null || true
    done

    # 2. Wi-Fi: Tắt power_save cho chip MediaTek MT7921 để chống rớt gói/lag mạng
    [ -n "$WIFI_IFACE" ] && iw dev "$WIFI_IFACE" set power_save off >/dev/null 2>&1 || true

    # 3. Intel iGPU: Giữ sàn 800MHz phản hồi 0ms
    for c in /sys/class/drm/card[0-9]*; do
        if [ -f "$c/gt_min_freq_mhz" ] && [ -f "$c/device/vendor" ] && [ "$(cat "$c/device/vendor" 2>/dev/null)" = "0x8086" ]; then
            echo 800 > "$c/gt_min_freq_mhz" 2>/dev/null || true
        fi
    done

    # 4. Tắt Ollama khi dùng pin (giữ local_mysql, local_phpmyadmin hoạt động cho học tập)
    if command -v docker >/dev/null 2>&1; then
        docker stop ollama >/dev/null 2>&1 || true
    fi

    # 5. NVIDIA PCIe Runtime PM auto (cho phép ngủ sâu D3cold)
    for pci in /sys/bus/pci/devices/0000:01:00.*/power/control; do
        [ -f "$pci" ] && echo "auto" > "$pci" 2>/dev/null || true
    done

    logger -t auto-power-profile "Switched to Battery Mode (CPU: balance_performance, iGPU: 800MHz, dGPU: D3cold)"
fi
